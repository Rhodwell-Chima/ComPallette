# ============================================================================
# COMPALLETTE DOCKER & BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================

# Security
SECRET_KEY=compallette-insecure-dev-key-change-in-production
DEBUG=1
ALLOWED_HOSTS=*

# Database (PostgreSQL)
POSTGRES_DB=compallette_db
POSTGRES_USER=compallette_user
POSTGRES_PASSWORD=compallette_secure_pass_2026
DB_HOST=db
DB_PORT=5432

# Mining Gateway API Key Authentication
COMPALLETTE_API_KEY=compallette-mining-secret-key-v1

# Inactivity Watchdog Limits (Seconds)
COMPALLETTE_STALE_SEC=20
COMPALLETTE_OFFLINE_SEC=45
