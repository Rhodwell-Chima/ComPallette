# ============================================================================
# COMPALLETTE DOCKER & BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================

# Security
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=0
# Set to the immutable source revision deployed by CI or before `docker compose up --build`.
COMPALLETTE_BUILD_REVISION=replace-with-source-revision
# Reserve this LAN IP for innovation-hub03.local; the ESP32 Gateway sends the resolved IP as HTTP Host.
ALLOWED_HOSTS=localhost,127.0.0.1,innovation-hub03.local,192.168.1.176
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
POSTGRES_DB=compallette_db
POSTGRES_USER=compallette_user
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DB_HOST=db
DB_PORT=5432

# Mining Gateway API Key Authentication
COMPALLETTE_API_KEY=replace-with-a-unique-device-api-key

# Inactivity Watchdog Limits (Seconds)
COMPALLETTE_STALE_SEC=20
COMPALLETTE_OFFLINE_SEC=45
